rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Public content: read published docs only, never write from client
    match /{col}/{doc} {
      allow read: if col in [
        'products',
        'batches',
        'qualityPillars',
        'certifications',
        'gallery',
        'downloads',
        'testimonials',
        'pages'
      ] && resource.data.published == true;
      allow write: if false;    // all writes go through Admin SDK
    }

    match /settings/{doc}   { allow read: if true;  allow write: if false; }
    match /enquiries/{doc}  { allow read, write: if false; }  // server-only
    match /distributorEnquiries/{doc} { allow read, write: if false; } // server-only
    match /admins/{uid}     { allow read: if isAdmin(); allow write: if false; }
  }
}
