<?xml version="1.0" encoding="UTF-8"?>
<svg width="400" height="500" viewBox="0 0 400 500" fill="none" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <linearGradient id="glass-vet-mastitis.svg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#2A170A" />
      <stop offset="35%" stop-color="#4E2C14" />
      <stop offset="70%" stop-color="#331B0C" />
      <stop offset="100%" stop-color="#170B04" />
    </linearGradient>
    <linearGradient id="cap-vet-mastitis.svg" x1="0" y1="0" x2="1" y2="0">
      <stop offset="0%" stop-color="#E2E8F0" />
      <stop offset="50%" stop-color="#FFFFFF" />
      <stop offset="100%" stop-color="#94A3B8" />
    </linearGradient>
    <filter id="shadow-vet-mastitis.svg" x="-10%" y="-10%" width="120%" height="130%" filterUnits="userSpaceOnUse">
      <feDropShadow dx="0" dy="16" stdDeviation="20" flood-color="#000000" flood-opacity="0.3" />
    </filter>
  </defs>

  <!-- Ground reflection / shadow -->
  <ellipse cx="200" cy="455" rx="100" ry="16" fill="#000000" fill-opacity="0.25" />

  <!-- Bottle Body Group -->
  <g filter="url(#shadow-vet-mastitis.svg)">
    <!-- Cap Neck -->
    <rect x="180" y="55" width="40" height="24" rx="3" fill="url(#cap-vet-mastitis.svg)" stroke="#94A3B8" stroke-width="1.5" />
    <rect x="175" y="76" width="50" height="12" rx="2" fill="url(#glass-vet-mastitis.svg)" stroke="#5C381E" stroke-width="1.5" />

    <!-- Main Bottle Body -->
    <path d="M 175 88 C 160 110, 130 120, 130 150 L 130 425 C 130 440, 142 448, 155 448 L 245 448 C 258 448, 270 440, 270 425 L 270 150 C 270 120, 240 110, 225 88 Z"
      fill="url(#glass-vet-mastitis.svg)" stroke="#5C381E" stroke-width="2" />

    <!-- Glass Highlights -->
    <path d="M 142 160 L 142 420" stroke="#FFFFFF" stroke-opacity="0.15" stroke-width="5" stroke-linecap="round" />
    <path d="M 150 160 L 150 420" stroke="#FFFFFF" stroke-opacity="0.08" stroke-width="2" stroke-linecap="round" />

    <!-- Product Label -->
    <rect x="145" y="165" width="110" height="235" rx="5" fill="#FAFAF8" stroke="#D1D5DB" stroke-width="1" />

    <!-- Label Brand Header -->
    <rect x="145" y="165" width="110" height="42" rx="5" fill="#15803D" />
    <rect x="145" y="202" width="110" height="5" fill="#86EFAC" />

    <text x="200" y="184" font-family="Arial, sans-serif" font-weight="900" font-size="11" fill="#FFFFFF" text-anchor="middle" letter-spacing="1">PHBL BONDED</text>
    <text x="200" y="197" font-family="Arial, sans-serif" font-weight="600" font-size="7" fill="#E2E8F0" text-anchor="middle" letter-spacing="0.5">ESTD. 2003 · HL-792 M</text>

    <!-- Product Title & Details -->
    <text x="200" y="238" font-family="Georgia, serif" font-weight="bold" font-size="14" fill="#111827" text-anchor="middle">Vet Mastitis</text>
    <rect x="165" y="248" width="70" height="1" fill="#15803D" fill-opacity="0.3" />

    <text x="200" y="266" font-family="Arial, sans-serif" font-weight="bold" font-size="8" fill="#15803D" text-anchor="middle" letter-spacing="0.5">VETERINARY DROPS</text>
    <text x="200" y="280" font-family="Arial, sans-serif" font-weight="bold" font-size="6" fill="#6B7280" text-anchor="middle" letter-spacing="1">HOMOEOVET</text>

    <!-- Botanical / Lab Crest -->
    <circle cx="200" cy="312" r="15" fill="#F3F4F6" stroke="#15803D" stroke-width="1" />
    <text x="200" y="316" font-family="Georgia, serif" font-weight="bold" font-size="11" fill="#15803D" text-anchor="middle">℞</text>

    <text x="200" y="342" font-family="Arial, sans-serif" font-size="6" fill="#4B5563" text-anchor="middle">Standard HPI Quality</text>
    <text x="200" y="352" font-family="Arial, sans-serif" font-size="5.5" fill="#9CA3AF" text-anchor="middle">Extra Neutral Alcohol Base</text>

    <!-- Label Footer -->
    <rect x="145" y="375" width="110" height="25" fill="#F3F4F6" />
    <text x="200" y="386" font-family="Arial, sans-serif" font-weight="bold" font-size="6" fill="#1F2937" text-anchor="middle">GMP &amp; ISO 9001 CERTIFIED</text>
    <text x="200" y="394" font-family="Arial, sans-serif" font-size="5" fill="#6B7280" text-anchor="middle">Paschim Medinipur, WB</text>
  </g>
</svg>